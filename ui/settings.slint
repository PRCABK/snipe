export component SettingsWindow inherits Window {
    in-out property <string> hotkey-screenshot: "F1";
    in-out property <string> hotkey-pin: "F2";
    in-out property <string> hotkey-color: "F3";
    in-out property <string> hotkey-longshot: "Ctrl+Alt+S";

    in-out property <bool> auto-start: false;
    in-out property <string> save-dir: "";
    in-out property <string> save-format: "png";

    in-out property <string> ai-base-url: "https://api.openai.com/v1";
    in-out property <string> ai-model: "gpt-4o-mini";
    in-out property <string> ai-key-masked: "未配置";
    in-out property <string> ai-new-key: "";
    in-out property <string> ai-test-status: "";

    callback save-settings();
    callback test-ai-connection();
    callback browse-save-dir();

    title: "Snipe 设置";
    width: 520px;
    height: 480px;
    background: #1C1C1C;
    default-font-family: "Segoe UI, Microsoft YaHei, sans-serif";

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "Snipe 参数设置";
            color: #FFFFFF;
            font-size: 18px;
            font-weight: 700;
        }

        // Hotkey section
        Rectangle {
            background: #242424;
            border-radius: 8px;
            border-color: #333333;
            border-width: 1px;
            padding: 12px;

            VerticalLayout {
                spacing: 8px;
                Text { text: "全局快捷键"; color: #0078D4; font-size: 13px; font-weight: 600; }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "普通截图"; color: #CCCCCC; font-size: 12px; vertical-alignment: center; }
                    TextInput { text: root.hotkey-screenshot; color: #FFFFFF; font-size: 12px; width: 120px; }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "屏幕取色"; color: #CCCCCC; font-size: 12px; vertical-alignment: center; }
                    TextInput { text: root.hotkey-color; color: #FFFFFF; font-size: 12px; width: 120px; }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "长截图"; color: #CCCCCC; font-size: 12px; vertical-alignment: center; }
                    TextInput { text: root.hotkey-longshot; color: #FFFFFF; font-size: 12px; width: 120px; }
                }
            }
        }

        // AI Configuration section
        Rectangle {
            background: #242424;
            border-radius: 8px;
            border-color: #333333;
            border-width: 1px;
            padding: 12px;

            VerticalLayout {
                spacing: 8px;
                Text { text: "AI 视觉服务 (OCR / 翻译)"; color: #0078D4; font-size: 13px; font-weight: 600; }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "API Base URL"; color: #CCCCCC; font-size: 12px; vertical-alignment: center; }
                    TextInput { text: root.ai-base-url; color: #FFFFFF; font-size: 12px; width: 280px; }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "视觉模型"; color: #CCCCCC; font-size: 12px; vertical-alignment: center; }
                    TextInput { text: root.ai-model; color: #FFFFFF; font-size: 12px; width: 280px; }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "API Key"; color: #CCCCCC; font-size: 12px; vertical-alignment: center; }
                    TextInput { text: root.ai-new-key; color: #FFFFFF; font-size: 12px; width: 280px; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.ai-test-status;
                        color: #AAAAAA;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 90px;
                        height: 26px;
                        background: #3A3A3A;
                        border-radius: 4px;
                        Text { text: "测试连接"; color: #FFFFFF; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.test-ai-connection(); } }
                    }
                }
            }
        }

        // General settings
        Rectangle {
            background: #242424;
            border-radius: 8px;
            border-color: #333333;
            border-width: 1px;
            padding: 12px;

            VerticalLayout {
                spacing: 8px;
                Text { text: "通用设置"; color: #0078D4; font-size: 13px; font-weight: 600; }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "开机自动启动"; color: #CCCCCC; font-size: 12px; vertical-alignment: center; }
                    Rectangle {
                        width: 44px;
                        height: 22px;
                        border-radius: 11px;
                        background: root.auto-start ? #0078D4 : #444444;
                        TouchArea { clicked => { root.auto-start = !root.auto-start; } }
                    }
                }
            }
        }

        // Save button footer
        HorizontalLayout {
            alignment: end;
            Rectangle {
                width: 120px;
                height: 34px;
                background: #0078D4;
                border-radius: 6px;
                Text { text: "保存配置"; color: #FFFFFF; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.save-settings(); } }
            }
        }
    }
}
